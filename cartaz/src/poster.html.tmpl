<meta charset="utf-8">
<title>Avanza Group Solutions — 7 de Setembro</title>
<style>
  @font-face{font-family:'Anton';src:url(__ANTON__) format('truetype');font-weight:400;font-style:normal}
  @font-face{font-family:'Montserrat';src:url(__MONT__) format('truetype-variations');font-weight:100 900;font-style:normal}

  :root{
    /* palette sampled pixel-for-pixel from the Avanza logotype */
    --navy:#132F5E;  --blue:#0878BA;  --cyan:#0AA1DD;
    --teal:#37B1AC;  --green:#84C044; --lime:#B0CE3F;
    --amber:#FABF1C; --orange:#F9A823;
  }

  *{margin:0;padding:0;box-sizing:border-box}
  html,body{background:#fff}
  .poster{
    position:relative;width:1170px;height:1451px;overflow:hidden;
    background:#fff url(__PLATE__) no-repeat top center / 1170px 1451px;
    font-family:'Montserrat',sans-serif;-webkit-font-smoothing:antialiased;
    text-rendering:geometricPrecision;
  }

  /* ---------- masthead ---------- */
  .masthead{position:absolute;top:108px;left:0;right:0;text-align:center}
  .masthead .name{
    font-weight:800;font-size:58px;line-height:1;letter-spacing:.075em;text-indent:.075em;
    color:var(--navy);text-transform:uppercase;
  }
  .masthead .name em{
    font-style:normal;
    background:linear-gradient(155deg,var(--cyan) 0%,var(--teal) 48%,var(--green) 100%);
    -webkit-background-clip:text;background-clip:text;color:transparent;
  }
  .masthead .rule{
    width:168px;height:4px;margin:20px auto 17px;border-radius:2px;
    background:linear-gradient(90deg,var(--green),var(--teal),var(--cyan),var(--blue));
  }
  .masthead .sub{
    font-weight:600;font-size:20px;line-height:1;letter-spacing:.46em;text-indent:.46em;
    color:var(--blue);text-transform:uppercase;
  }

  /* ---------- editorial block (geometry mirrors the reference poster) ---------- */
  .eyebrow{
    position:absolute;left:118px;top:803px;
    font-weight:700;font-size:27px;line-height:1;letter-spacing:.25em;text-indent:.25em;
    color:var(--orange);text-transform:uppercase;
  }
  .headline{
    position:absolute;left:118px;top:844px;
    font-family:'Anton',sans-serif;font-weight:400;text-transform:uppercase;
    font-size:99px;line-height:101px;letter-spacing:-.048em;white-space:nowrap;
  }
  .headline span{margin-right:.20em}
  .headline .w1{color:var(--green)}
  .headline .w2{color:var(--teal)}
  .headline .w3{color:var(--cyan)}
  .headline .w4{color:var(--blue)}
  .headline .w5{color:var(--navy)}

  .message{position:absolute;left:118px;top:1055px;display:flex;flex-direction:column;align-items:flex-start;gap:7px}
  .message span{
    background:var(--navy);color:#fff;
    font-weight:500;font-size:33px;line-height:33px;letter-spacing:.004em;
    padding:10px 18px 11px;
  }

  /* ---------- signature logotype ---------- */
  .mark{position:absolute;right:112px;bottom:258px;width:308px}
  .mark img{display:block;width:100%;height:auto}

  /* ---------- footer band ---------- */
  .band{
    position:absolute;left:0;right:0;bottom:0;height:222px;
    background:linear-gradient(110deg,
      var(--lime) 0%, var(--green) 14%, var(--teal) 33%,
      var(--cyan) 53%, var(--blue) 73%, var(--navy) 100%);
    display:flex;align-items:center;justify-content:space-between;padding:0 118px;
  }
  .band .brand{font-weight:600;font-size:30px;line-height:1;letter-spacing:.015em;color:#fff}
  .band .social{display:flex;gap:20px;margin-top:22px}
  .band .social svg{width:37px;height:37px;fill:#fff;display:block}
  /* replace with the real website / social handle once available */
  .band .tagline{
    font-weight:700;font-size:24px;line-height:1.45;letter-spacing:.16em;text-indent:.16em;
    color:#fff;text-align:right;text-transform:uppercase;
  }
</style>

<div class="poster">
  <div class="masthead">
    <div class="name">A<em>V</em>ANZA</div>
    <div class="rule"></div>
    <div class="sub">Group Solutions</div>
  </div>

  <div class="eyebrow">7 de Setembro</div>

  <div class="headline">
    <div><span class="w1">Feliz</span><span class="w2">Dia</span><span class="w3">dos</span></div>
    <div><span class="w4">Acordos</span><span class="w5">de Lusaka</span></div>
  </div>

  <div class="message">
    <span>Do passado que nos uniu nasce</span>
    <span>a força que nos faz avançar.</span>
  </div>

  <div class="mark"><img src="__LOGO__" alt="Avanza Group Solutions"></div>

